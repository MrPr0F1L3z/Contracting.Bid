# The staging stack: a committed build under test, with sim data in its own database.
# Read by docker compose (--env-file) and by pnpm stack. No secrets here: this file is committed.
APP_STACK=staging
COMPOSE_PROJECT_NAME=contracting-staging
DB_PORT=5433
DASHBOARD_PORT=4200
# Where staging's runs get their jobs: samgov (real listings, read-only) or stub (made-up).
# Change it here, commit, and deploy staging again. SAM_GOV_API_KEY comes from the checkout's .env.
JOB_SOURCE=samgov
