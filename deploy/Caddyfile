# Serves the owner dashboard over HTTPS. Caddy gets and renews the
# certificate for DASHBOARD_DOMAIN from Let's Encrypt on its own.
{$DASHBOARD_DOMAIN} {
	encode gzip
	# The dashboard service on the Compose network (DASHBOARD_UPSTREAM overrides it).
	reverse_proxy {$DASHBOARD_UPSTREAM:dashboard:4100} {
		# Send live events (server-sent events) straight through.
		flush_interval -1
	}
	header -Server
}
