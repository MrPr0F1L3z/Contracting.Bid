# Copy to .env on your machine. Never commit .env.

# Claude (President and PM)
ANTHROPIC_API_KEY=

# Local vLLM server (OpenAI-compatible). From inside Docker, use host.docker.internal.
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=not-needed
VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# Optional cap on a job's estimated value, in US dollars. Leave empty for no cap.
# Jobs come from a stub of made-up solicitations for now; a read-only SAM.gov source comes later.
MAX_JOB_VALUE_USD=

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://contracting:contracting@db:5432/contracting

# Per-run Claude spending cap in US dollars
RUN_BUDGET_USD=5

# GPU processes to pause before a run and resume after (JSON list of shell commands).
# Example: [{"pause":"docker pause my-gpu-app","resume":"docker unpause my-gpu-app"}]
GPU_PAUSE_HOOKS=[]
