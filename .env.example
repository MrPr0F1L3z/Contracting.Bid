# Copy to .env on your machine. Never commit .env.

# Claude (President and PM)
ANTHROPIC_API_KEY=
# Model for the President and PM, and a cheaper one for other roles in --models cloud
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_WORKER_MODEL=claude-sonnet-5-5

# Local vLLM server (OpenAI-compatible), started by vllm_service on port 8001.
# It listens on 127.0.0.1 only, so a Docker container cannot reach it through
# host.docker.internal; run the CLI on the host.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=not-needed
VLLM_MODEL=qwen3.8-27b-abliterated

# Jobs come from a stub of made-up solicitations for now; a read-only SAM.gov source comes later.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://contracting:contracting@db:5432/contracting

# vLLM reuse-or-restart check. The runner reuses a running server only when a
# lane is free and a short probe answers within the limits below.
VLLM_MAX_LANES=2
VLLM_MAX_RESPONSE_SEC=60
VLLM_MIN_TOKENS_PER_SEC=5
VLLM_STOP_CMD=vllm_service stop
VLLM_START_CMD=vllm_service start big

# Per-run Claude spending cap in US dollars
RUN_BUDGET_USD=5

# Commands that free the GPU before a run and restore it after (JSON list).
# Ollama and any existing vLLM processes may be stopped for a run.
# Note: pausing a process (docker pause, kill -STOP) does NOT free its VRAM.
# Use commands that stop the process, and commands that start it again.
# Example for a systemd Ollama service and a vLLM container named "vllm":
# GPU_PAUSE_HOOKS=[{"pause":"sudo systemctl stop ollama","resume":"sudo systemctl start ollama"},{"pause":"docker stop vllm","resume":"docker start vllm"}]
GPU_PAUSE_HOOKS=[]
